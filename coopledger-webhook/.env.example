FIREBASE_PROJECT_ID=coopledger-3cf7c
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@coopledger-3cf7c.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# FedaPay (serveur uniquement) — appels API depuis /api/fedapay/*
FEDAPAY_SECRET_KEY=sk_sandbox_xxx
# Secret partagé avec l’app mobile (header X-CoopLedger-Secret) — même valeur que EXPO_PUBLIC_COOPLEDGER_PROXY_SECRET dans l’app
MOBILE_PROXY_SECRET=remplacer_par_un_secret_long_aleatoire
PORT=3000
# Polygon Amoy — enregistrement on-chain depuis POST /webhook/fedapay (ethers)
POLYGON_AMOY_RPC=https://rpc-amoy.polygon.technology
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
# Clé privée du compte serveur autorisé à appeler enregistrerTransaction() sur le contrat
WEBHOOK_CHAIN_PRIVATE_KEY=0x_remplacer
