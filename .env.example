# Copier ce fichier : cp .env.example .env
# Ne jamais committer .env (déjà dans .gitignore)

# Clé privée MetaMask (Amoy) — UNE ligne, PAS d'espace après le "="
# Correct :   DEPLOYER_PRIVATE_KEY=0xabcdef...
# Incorrect : DEPLOYER_PRIVATE_KEY= 0xabcdef...   (espace après =)
DEPLOYER_PRIVATE_KEY=01c16626725b76a60de1d50117439275ec7ab634930710e18e775df54b7f45a7
PRESIDENT_NOM=Super Admin

# Cloudinary (upload justificatifs depuis l’app) — cloud name du tableau de bord Cloudinary
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=df6sd4prg
