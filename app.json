{
  "expo": {
    "name": "CoopLedger",
    "slug": "coopledger-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "updates": {
      "url": "https://u.expo.dev/6b29078a-377a-4d1f-b442-ebb6b8b90850"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#14532d"
    },
    "android": {
      "package": "com.coopledger.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#14532d"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "androidNavigationBar": {
      "backgroundColor": "#ffffff",
      "barStyle": "dark-content"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#15803d",
          "defaultChannel": "votes",
          "androidMode": "default",
          "androidCollapsedTitle": "CoopLedger"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CoopLedger accède à tes photos pour joindre un justificatif.",
          "cameraPermission": "CoopLedger utilise la caméra pour photographier un justificatif."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "6b29078a-377a-4d1f-b442-ebb6b8b90850"
      }
    }
  }
}
